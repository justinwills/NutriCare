{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/pantry/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/meals/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/notifications/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/doctor/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/ocr/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/supervision/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/food-gallery/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/auth",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/pantry",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/meals",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/notifications",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/doctor",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/ocr",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/supervision",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/food-gallery",
      "destination": {
        "type": "service",
