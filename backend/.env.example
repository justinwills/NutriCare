DATABASE_URL=postgresql://user:password@localhost:5432/reverie
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
PORT=3002
# Optional: path to the Python executable with paddleocr and deep-translator installed.
# Defaults to ../.venv/Scripts/python.exe on Windows and ../.venv/bin/python elsewhere.
PYTHON_EXECUTABLE=
# Receipt OCR provider: auto uses hosted vision on Vercel and PaddleOCR locally.
# Set to vision or paddle to override auto detection.
OCR_PROVIDER=auto
# Vision provider for receipt OCR on Vercel and plate-photo recognition.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint, useful for another hosted provider.
OPENAI_BASE_URL=https://api.openai.com/v1
